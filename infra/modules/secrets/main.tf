# Four secret containers (Requirement 7.1 plus the origin-verify container). All
# four are retained resources (ADR-015): the Secrets Manager recovery window blocks re-creating the same
# name, so a mistaken plan must never destroy one.

resource "aws_secretsmanager_secret" "apple_pass" {
  name        = "${local.secret_prefix}/apple-pass"
  description = "Apple Pass Type ID certificate and key, loaded by the owner out of band."

  lifecycle {
    prevent_destroy = true
  }
}

resource "aws_secretsmanager_secret" "google_wallet" {
  name        = "${local.secret_prefix}/google-wallet"
  description = "Google Wallet service account key, loaded by the owner out of band."

  lifecycle {
    prevent_destroy = true
  }
}

# Changing a description later updates the deployed secret description in place,
# which is harmless before launch; the secret and its value are not replaced.
resource "aws_secretsmanager_secret" "app" {
  name        = "${local.secret_prefix}/app"
  description = "Application pepper, generated and loaded by the owner script."

  lifecycle {
    prevent_destroy = true
  }
}

# The origin-verify value has its own container so it can be rotated without
# touching the pepper: a rotation writes this secret only, and the pepper (which
# every subHash derives from) is never read or rewritten by it.
resource "aws_secretsmanager_secret" "origin_verify" {
  name        = "${local.secret_prefix}/origin-verify"
  description = "Origin-verify value that CloudFront sends to the API, loaded by the owner script."

  lifecycle {
    prevent_destroy = true
  }
}

# Terraform creates the four containers only and sets no value for any of them.
# The Apple and Google values, and the pepper and origin-verify value of the app
# secret, are loaded by the owner with scripts/load-secrets.sh, so no secret value
# is generated by Terraform and none is written by it (Requirements 7.5 and 7.6,
# and the S5 security review). A later apply therefore never overwrites a loaded
# value.
