# Example Terraform variables for the dev environment (foundation-contracts, S0).
#
# Copy to terraform.tfvars and fill in real values locally. The real file is
# git-ignored and is never committed. Placeholder values only: no secret, token,
# certificate, key, account identifier or real domain. HCP dynamic provider
# credentials supply AWS access, so no AWS key appears here (tech.md, ADR-014).
#
# This file contains no em dash or en dash.

# Deployment environment name.
environment = "dev"

# AWS region for every resource (tech.md: us-east-1 for everything).
aws_region = "us-east-1"

# The email address that receives budget and alarm notifications. Placeholder
# only; set your real address in the local terraform.tfvars.
alert_email = "alerts@example.invalid"

# Monthly budget ceiling in USD for the dev environment (a number, not a secret).
monthly_budget_usd = 15
