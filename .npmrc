# Pin resolution policy for the monorepo (foundation-contracts, S0).
#
# save-exact keeps every dependency written as an exact version (no range,
# caret or tilde), matching the pinned dependency table in the S0 design.
save-exact=true
#
# legacy-peer-deps lets npm install and npm ci resolve the tree while
# openapi-typescript 7.13.0 still declares its peer as typescript ^5.x.
# The project pins typescript 6.0.3 on purpose (Angular 22.2 and
# typescript-eslint both require typescript >=6.0 <6.1). TypeScript 6 is
# backward compatible for openapi-typescript's generation use, so the peer
# declaration is a lag, not a real incompatibility. Recording it here keeps
# a fresh clone and CI (npm ci) resolving the same tree as the lockfile.
legacy-peer-deps=true
