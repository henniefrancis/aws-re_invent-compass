# Pin resolution policy for the monorepo (foundation-contracts, S0).
#
# save-exact keeps every dependency written as an exact version (no range,
# caret or tilde), matching the pinned dependency table in the S0 design.
save-exact=true
#
# The openapi-typescript 7.13.0 peer declaration lags at typescript ^5.x,
# while the project pins typescript 6.0.3 on purpose (Angular 22.2 and
# typescript-eslint both require typescript >=6.0 <6.1). Rather than relax
# resolution globally with legacy-peer-deps, the root package.json scopes a
# single override (overrides.openapi-typescript.typescript = $typescript) so
# only that one peer is satisfied from the pinned typescript. A fresh clone
# and CI (npm ci) then resolve the same tree as the lockfile with no legacy
# flags.
