# ------------------------------------------------------------------
# PRIVATE: never commit (see "Public and private" in .kiro/steering/tech.md)
# ------------------------------------------------------------------

# Environment and local config (commit the .example versions instead)
.env
.env.*
!.env.example

# Terraform account-specific values and state
*.tfvars
*.tfvars.json
!*.tfvars.example
cloud.auto.tfbackend
!cloud.auto.tfbackend.example
*.tfstate
*.tfstate.*
*.tfplan
tfplan
.terraform/
crash.log
crash.*.log
# Infra build output (Lambda zips from scripts/release.sh). The lock files of the
# three roots (infra/bootstrap, infra/envs/dev, infra/envs/prod) ARE committed,
# generated for every platform with terraform providers lock. Lock files of the
# modules and of infra itself are test scaffolding and are not committed.
infra/build/
infra/.terraform.lock.hcl
infra/modules/**/.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Wallet signing material and keys
*.p12
*.pfx
*.pem
*.key
*.secret
*.secret.txt
*.p8
*.cer
*.crt
*.pkpass
*service-account*.json
*credentials*.json
secrets/
# The infra secrets module holds Terraform only (no secret material), so it is tracked.
!infra/modules/secrets/

# Raw API recordings (may contain personal data); only scrubbed fixtures are committed
fixtures/.raw/

# Local Compass data (catalog cache, issued pass records)
.compass/

# ------------------------------------------------------------------
# Build output and tooling
# ------------------------------------------------------------------
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo
.pnpm-store/
*.log
npm-debug.log*
pnpm-debug.log*

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Angular CLI cache
.angular/

# Playwright output
site/playwright-report/
site/test-results/
