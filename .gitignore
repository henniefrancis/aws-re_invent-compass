# ------------------------------------------------------------------
# PRIVATE: never commit (see "Public and private" in .kiro/steering/tech.md)
# ------------------------------------------------------------------

# Environment and local config (commit the .example versions instead)
.env
.env.*
!.env.example

# Terraform account-specific values and state
*.tfvars
*.tfvars.json
!*.tfvars.example
cloud.auto.tfbackend
!cloud.auto.tfbackend.example
*.tfstate
*.tfstate.*
*.tfplan
tfplan
.terraform/
crash.log
crash.*.log
# Infra build output (Lambda zips from scripts/release.sh) and provider lock files
# (generated per platform; the owner creates them with terraform providers lock)
infra/build/
.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Wallet signing material and keys
*.p12
*.pfx
*.pem
*.key
*.p8
*.cer
*.crt
*.pkpass
*service-account*.json
*credentials*.json
secrets/
# The infra secrets module holds Terraform only (no secret material), so it is tracked.
!infra/modules/secrets/

# Raw API recordings (may contain personal data); only scrubbed fixtures are committed
fixtures/.raw/

# Local Compass data (catalog cache, issued pass records)
.compass/

# ------------------------------------------------------------------
# Build output and tooling
# ------------------------------------------------------------------
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo
.pnpm-store/
*.log
npm-debug.log*
pnpm-debug.log*

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
