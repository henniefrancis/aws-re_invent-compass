{
  "name": "reinvent-compass",
  "version": "0.1.3",
  "description": "Scans your code and GitHub repositories to find the AWS re:Invent sessions that match your stack, books them safely with guardrails, and puts unofficial Boarding Passes on your phone. Independent community project, not affiliated with AWS.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "kiro",
    "kiro-power",
    "aws",
    "reinvent",
    "re:Invent",
    "conference",
    "sessions",
    "schedule",
    "boarding-pass",
    "wallet",
    "first-timer"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henniefrancis/aws-re_invent-compass.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://reinvent-compass.vegas",
  "bugs": {
    "url": "https://github.com/henniefrancis/aws-re_invent-compass/issues"
  },
  "type": "module",
  "bin": {
    "reinvent-compass": "dist/bin.js"
  },
  "files": [
    "dist/bin.js",
    "dist/scan-worker.js",
    "dist/github-scan-worker.js",
    "dist/data",
    "dist/sample-repo",
    "dist/fixtures",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.1"
  },
  "devDependencies": {
    "@compass/contracts": "0.0.0",
    "@compass/core": "0.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
