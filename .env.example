# Example environment file for re:Invent Compass (foundation-contracts, S0).
#
# Copy to .env and fill in real values locally. The real .env is git-ignored and
# is never committed. This example contains placeholder values only: no secret,
# token, certificate, key, account identifier or real domain.
#
# This file contains no em dash or en dash.

# Run mode. "simulated" uses committed fixtures and never calls the live API.
# Tests always run with COMPASS_MODE=simulated. Use "live" only in the real
# product on an attendee's own machine.
COMPASS_MODE=simulated

# Set to 1 only by the owner, locally, to allow live API tests. CI never sets it.
COMPASS_LIVE_TESTS=0

# The public CloudFront domain the Compass API and site are served from. Use the
# distribution domain only; do not put a custom or real domain here.
COMPASS_PUBLIC_BASE_URL=https://REPLACE_WITH_DISTRIBUTION.cloudfront.net

# The email address that receives budget and alarm notifications. Placeholder
# only; set your real address in the local .env.
COMPASS_ALERT_EMAIL=alerts@example.invalid
